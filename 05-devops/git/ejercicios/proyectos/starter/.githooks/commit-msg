#!/bin/bash
# Hook commit-msg: valida que el mensaje siga Conventional Commits.
set -euo pipefail
MSG_FILE="$1"
MSG=$(head -1 "$MSG_FILE")

# Patrón: tipo(ámbito opcional)!: descripción  |  tipo: descripción
if ! echo "$MSG" | grep -qE "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?!?: .+"; then
    echo "Mensaje de commit inválido. Debe seguir Conventional Commits:"
    echo "  tipo(ámbito): descripción"
    echo "  Ej: feat(auth): añade login"
    echo "Mensaje recibido: $MSG"
    exit 1
fi
exit 0
