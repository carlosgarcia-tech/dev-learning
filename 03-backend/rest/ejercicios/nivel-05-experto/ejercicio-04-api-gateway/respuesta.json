{
  "routes": [
    { "path": "/products", "service": "products-service", "methods": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
    { "path": "/orders", "service": "orders-service", "methods": ["GET", "POST", "PUT", "PATCH", "DELETE"] }
